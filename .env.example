# Copy this file to .env.local and add your key. Never commit .env.local.
GROQ_API_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
COMPILER_SERVICE_URL=
COMPILER_SERVICE_SECRET=
# Optional: enables automatic DigiKey lookup of unknown exact part numbers and their datasheets.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
GROQ_ARCHITECT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b
GROQ_CHANGE_MODELS=openai/gpt-oss-120b,meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b,openai/gpt-oss-20b
GROQ_ASSISTANT_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b
GROQ_FIRMWARE_MODELS=qwen/qwen3-32b,qwen/qwen3.6-27b,openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# Backward-compatible fallback used when assistant/firmware-specific lists are absent.
GROQ_BUILDER_MODELS=
